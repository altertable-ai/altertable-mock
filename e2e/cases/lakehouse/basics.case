# Scalar queries with no table involved.

query
SELECT 42 AS answer
----
[{"name":"answer","type":"INTEGER"}]
[42]

query
SELECT 1 AS a, 'two' AS b, 3.5 AS c, true AS d
----
[{"name":"a","type":"INTEGER"},{"name":"b","type":"VARCHAR"},{"name":"c","type":"DECIMAL(2, 1)"},{"name":"d","type":"BOOLEAN"}]
[1,"two",3.5,true]

# Unnamed expressions keep DuckDB's generated column names.
query
SELECT 1 + 1, upper('mock')
----
[{"name":"(1 + 1)","type":"INTEGER"},{"name":"upper('mock')","type":"VARCHAR"}]
[2,"MOCK"]

query
SELECT * FROM range(3) AS t(i)
----
[{"name":"i","type":"BIGINT"}]
[0]
[1]
[2]

# An empty result still reports its columns.
query
SELECT 1 AS never WHERE false
----
[{"name":"never","type":"INTEGER"}]
